# Dependencies
# Ignore the folder where all the npm packages are installed.
/node_modules/

# Build output
# Ignore folders generated by Electron builders like electron-builder or electron-forge.
/dist/
/out/

# Logs
# Ignore log files that might be generated during development or runtime.
*.log
npm-debug.log*

# Operating System files
# Ignore system-specific files that don't belong in the repository.
.DS_Store
Thumbs.db

# Environment variables
# Ignore files containing environment variables, which may include sensitive data.
.env
